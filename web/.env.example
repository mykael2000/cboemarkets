DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=commas_web
DB_USER=root
DB_PASS=

APP_URL=http://3ctraders.com
APP_KEY=change_me_32_char_secret_key_here
APP_ENV=local

AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
AWS_REGION=us-east-1
SES_FROM_EMAIL=noreply@yourdomain.com
SES_FROM_NAME=Cboemarkets

# Email driver: 'ses' or 'smtp'
EMAIL_DRIVER=ses

# SMTP settings (used when EMAIL_DRIVER=smtp)
SMTP_HOST=smtp.yourhost.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=Cboemarkets
SMTP_SECURE=tls # tls | ssl | none

# OTP resend policy (seconds)
OTP_RESEND_COOLDOWN=60
OTP_MAX_RESENDS=3

# Google reCAPTCHA keys
# Get keys at: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here
