RewriteEngine On

# Remove .php extension from URL (internally)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]

# Redirect .php to non-.php (301 redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]+\\ +.*\.php[?]
RewriteRule ^(.*)\.php$ /$1 [R=301,L,NC]

# Protect .htaccess
<Files .htaccess>
    order allow,deny
    deny from all
</Files>

# Protect .env
<Files .env>
    order allow,deny
    deny from all
</Files>
